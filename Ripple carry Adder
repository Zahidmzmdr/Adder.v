// full adder module 
module full_adder(
    input a, b, cin,
    output sum, cout
);

assign sum  = a ^ b ^ cin;
assign cout = (a & b) | (b & cin) | (a & cin);

endmodule





// for 32 bit module i choose to use for loop 
module ripple_carry_adder_32bit(
    input  [31:0] A,
    input  [31:0] B,
    input         Cin,
    output [31:0] Sum,
    output        Cout
);

wire [32:0] C;

assign C[0] = Cin;
assign Cout = C[32];

genvar i;

generate
    for (i = 0; i < 32; i = i + 1) begin : RCA
        full_adder FA (
            .a(A[i]),
            .b(B[i]),
            .cin(C[i]),
            .sum(Sum[i]),
            .cout(C[i+1])
        );
    end
endgenerate

endmodule
